{
  "block": [
    "# --- слова и фразы: совпадение по границам слов ---",
    "ужас",
    "хоррор",
    "смертельная гонка",

    "# --- целые названия: точное совпадение ---",
    "= Пила",
    "= Пас",
    "= Пункт назначения",
    "= The Purge",

    "# --- регулярные выражения ---",
    "re:^пила\\s*\\d*$",
    "re:^\\bсекс",
    "re:(18\\+|только для взрослых|секс)"
  ],

  "allow": [
    "# исключения: побеждают блокировку",
    "= Ужасы нашего городка"
  ]
}

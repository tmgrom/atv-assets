{
  "# apiHost": "хост API; применяется со следующего запуска приложения",
  "# apiHostMode": "u — хост-прокси (apiBase → <host>/api/v1/), a — хост API (<host>/v1/)",
  "apiHost": "https://ro03.flexcdn.cloud",
  "apiHostMode": "u",

  "block": [
    "# --- слова и фразы: совпадение по границам слов ---",
    "ужас",
    "хоррор",
    "смертельная гонка",

    "# --- целые названия: точное совпадение ---",
    "= Пила",
    "= Пас",
    "= По-настоящему обнажён",
    "= Пункт назначения",
    "= The Purge",

    "# --- регулярные выражения ---",
    "re:^пила\\s*\\d*$",
    "re:^\\bсекс",
    "re:^\\bшлюх",
    "re:(18\\+|только для взрослых|секс)"
  ],

  "allow": [
    "# исключения: побеждают блокировку",
    "= Ужасы нашего городка"
  ]
}
